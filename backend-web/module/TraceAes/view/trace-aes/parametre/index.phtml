<h1>Paramètres — Seuils du moteur d'alertes</h1>
<p class="text-muted">Ces valeurs pilotent directement le déclenchement automatique des alertes (dossier technique, section 3).</p>

<?php if ($succes): ?>
<div class="alert alert-success">Paramètres mis à jour.</div>
<?php endif; ?>

<?php if ($erreurs): ?>
<div class="alert alert-danger">
    <ul class="mb-0">
        <?php foreach ($erreurs as $erreur): ?>
        <li><?= $this->escapeHtml($erreur) ?></li>
        <?php endforeach; ?>
    </ul>
</div>
<?php endif; ?>

<form method="post">
    <?php foreach ($parametres as $parametre): ?>
    <div class="mb-3">
        <label for="param_<?= $this->escapeHtmlAttr($parametre['cle']) ?>" class="form-label">
            <?= $this->escapeHtml($parametre['libelle']) ?>
        </label>
        <input type="number" step="0.1" name="valeur[<?= $this->escapeHtmlAttr($parametre['cle']) ?>]"
            id="param_<?= $this->escapeHtmlAttr($parametre['cle']) ?>" class="form-control" style="max-width: 200px;"
            value="<?= $this->escapeHtmlAttr($parametre['valeur']) ?>" required>
        <?php if ($parametre['description']): ?>
        <small class="form-text text-muted"><?= $this->escapeHtml($parametre['description']) ?></small>
        <?php endif; ?>
    </div>
    <?php endforeach; ?>
    <button type="submit" class="btn btn-success">Enregistrer</button>
</form>
