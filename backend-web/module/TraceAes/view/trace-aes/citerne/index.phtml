<h1>Citernes</h1>
<p><a href="/trace-aes/citerne/add" class="btn btn-success btn-sm">+ Nouvelle citerne</a></p>
<table class="table">
    <thead>
        <tr><th>ID</th><th>Immatriculation</th><th>Capacité (L)</th></tr>
    </thead>
    <tbody>
    <?php foreach ($citernes as $citerne): ?>
        <tr>
            <td><?= $this->escapeHtml($citerne['id']) ?></td>
            <td><a href="/trace-aes/citerne/view/<?= $this->escapeHtmlAttr($citerne['id']) ?>"><?= $this->escapeHtml($citerne['immatriculation']) ?></a></td>
            <td><?= $this->escapeHtml($citerne['capacite_litres']) ?></td>
        </tr>
    <?php endforeach; ?>
    <?php if (! count($citernes)): ?>
        <tr><td colspan="3" class="text-muted">Aucune citerne.</td></tr>
    <?php endif; ?>
    </tbody>
</table>
