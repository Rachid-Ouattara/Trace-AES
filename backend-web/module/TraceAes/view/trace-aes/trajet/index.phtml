<?php
$badgeParStatut = [
    'en_cours' => 'bg-primary',
    'termine' => 'bg-success',
    'interrompu' => 'bg-danger',
];
?>
<h1>Trajets</h1>
<p><a href="/trace-aes/trajet/add" class="btn btn-success btn-sm">+ Nouveau trajet</a></p>
<table class="table">
    <thead>
        <tr><th>ID</th><th>Chargement</th><th>Statut</th><th>Arrivée prévue</th></tr>
    </thead>
    <tbody>
