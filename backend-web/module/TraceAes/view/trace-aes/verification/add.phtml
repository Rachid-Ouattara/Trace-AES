<h1>Vérification à l'arrivée</h1>

<?php if ($resultat): ?>
<div class="alert alert-success">
    Vérification enregistrée.
    <?php if ($resultat['alertes_generees'] > 0): ?>
    <strong><?= $this->escapeHtml($resultat['alertes_generees']) ?> alerte(s) générée(s)</strong> —
    <a href="/trace-aes/alerte?statut=nouvelle">voir les alertes</a>.
    <?php else: ?>
    Aucune anomalie détectée.
    <?php endif; ?>
</div>
<?php endif; ?>

<?php if ($erreurs): ?>
<div class="alert alert-danger">
    <ul class="mb-0">
        <?php foreach ($erreurs as $erreur): ?>
        <li><?= $this->escapeHtml($erreur) ?></li>
        <?php endforeach; ?>
    </ul>
</div>
<?php endif; ?>

<form method="post">
    <div class="form-group">
        <label for="trajet_id">Trajet</label>
        <select name="trajet_id" id="trajet_id" class="form-control" required>
            <option value="">-- Sélectionner --</option>
            <?php foreach ($trajets as $trajet): ?>
            <option value="<?= $this->escapeHtmlAttr($trajet['id']) ?>"
                <?= (isset($donnees['trajet_id']) && $donnees['trajet_id'] == $trajet['id']) ? 'selected' : '' ?>>
                Trajet #<?= $this->escapeHtml($trajet['id']) ?> (chargement #<?= $this->escapeHtml($trajet['chargement_id']) ?>)
            </option>
            <?php endforeach; ?>
        </select>
        <?php if (! count($trajets)): ?>
        <small class="form-text text-muted">Aucun trajet en cours à vérifier. <a href="/trace-aes/trajet/add">Créer un trajet</a>.</small>
        <?php endif; ?>
    </div>
    <div class="form-group">
        <label for="point_controle_id">Point de contrôle</label>
        <select name="point_controle_id" id="point_controle_id" class="form-control" required>
            <option value="">-- Sélectionner --</option>
            <?php foreach ($pointsControle as $point): ?>
            <option value="<?= $this->escapeHtmlAttr($point['id']) ?>"
                <?= (isset($donnees['point_controle_id']) && $donnees['point_controle_id'] == $point['id']) ? 'selected' : '' ?>>
                <?= $this->escapeHtml($point['nom']) ?> (<?= $this->escapeHtml($point['ville']) ?>)
            </option>
            <?php endforeach; ?>
        </select>
    </div>
    <div class="form-group">
        <label for="agent_id">Agent de brigade</label>
        <select name="agent_id" id="agent_id" class="form-control" required>
            <option value="">-- Sélectionner --</option>
            <?php foreach ($agentsBrigade as $agent): ?>
            <option value="<?= $this->escapeHtmlAttr($agent['id']) ?>"
                <?= (isset($donnees['agent_id']) && $donnees['agent_id'] == $agent['id']) ? 'selected' : '' ?>>
                <?= $this->escapeHtml($agent['prenom'] . ' ' . $agent['nom']) ?>
            </option>
            <?php endforeach; ?>
        </select>
    </div>
    <div class="form-group">
        <label for="volume_mesure_litres">Volume mesuré (L)</label>
        <input type="number" step="0.01" name="volume_mesure_litres" id="volume_mesure_litres"
            class="form-control" value="<?= $this->escapeHtmlAttr($donnees['volume_mesure_litres'] ?? '') ?>" required>
    </div>
    <div class="form-group">
        <label for="etat_scelle_constate">État du scellé constaté</label>
        <select name="etat_scelle_constate" id="etat_scelle_constate" class="form-control" required>
            <option value="intact" <?= (isset($donnees['etat_scelle_constate']) && $donnees['etat_scelle_constate'] === 'intact') ? 'selected' : '' ?>>Intact</option>
            <option value="rompu" <?= (isset($donnees['etat_scelle_constate']) && $donnees['etat_scelle_constate'] === 'rompu') ? 'selected' : '' ?>>Rompu</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Enregistrer la vérification</button>
</form>
