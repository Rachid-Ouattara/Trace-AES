<h1>Chargements</h1>
<p><a href="/trace-aes/chargement/add" class="btn btn-success btn-sm">+ Nouveau chargement</a></p>
<table class="table">
    <thead>
        <tr><th>ID</th><th>Citerne</th><th>Volume déclaré (L)</th><th>Date</th></tr>
    </thead>
    <tbody>
    <?php foreach ($chargements as $chargement): ?>
        <tr>
            <td><?= $this->escapeHtml($chargement['id']) ?></td>
            <td><a href="/trace-aes/chargement/view/<?= $this->escapeHtmlAttr($chargement['id']) ?>"><?= $this->escapeHtml($chargement['citerne_id']) ?></a></td>
            <td><?= $this->escapeHtml($chargement['volume_declare_litres']) ?></td>
            <td><?= $this->escapeHtml($chargement['date_chargement']) ?></td>
        </tr>
