        </select>
    </p>
    <p>
        <label for="depot_id">Dépôt</label><br>
        <select name="depot_id" id="depot_id" required>
            <option value="">-- Sélectionner --</option>
            <?php foreach ($depots as $depot): ?>
            <option value="<?= $this->escapeHtmlAttr($depot['id']) ?>"
                <?= (isset($donnees['depot_id']) && $donnees['depot_id'] == $depot['id']) ? 'selected' : '' ?>>
                <?= $this->escapeHtml($depot['nom']) ?>
            </option>
            <?php endforeach; ?>
        </select>
    </p>
    <p>
        <label for="agent_depot_id">Agent de dépôt</label><br>
        <select name="agent_depot_id" id="agent_depot_id" required>
            <option value="">-- Sélectionner --</option>
