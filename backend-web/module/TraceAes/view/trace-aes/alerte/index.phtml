<?php
$badgeParStatut = [
    'nouvelle' => 'bg-danger',
    'traitee' => 'bg-success',
    'fausse_alerte' => 'bg-secondary',
];
?>
<h1>Alertes<?= $statut ? ' — statut : ' . $this->escapeHtml($statut) : '' ?></h1>
<form method="get" class="d-flex align-items-center gap-2 mb-3">
    <label for="statut" class="form-label mb-0">Filtrer par statut</label>
    <select name="statut" id="statut" class="form-select w-auto" onchange="this.form.submit()">
        <option value="">Toutes</option>
        <option value="nouvelle" <?= $statut === 'nouvelle' ? 'selected' : '' ?>>Nouvelle</option>
        <option value="traitee" <?= $statut === 'traitee' ? 'selected' : '' ?>>Traitée</option>
        <option value="fausse_alerte" <?= $statut === 'fausse_alerte' ? 'selected' : '' ?>>Fausse alerte</option>
    </select>
</form>
<table class="table">
    <thead>
        <tr><th>ID</th><th>Type</th><th>Trajet</th><th>Statut</th><th>Détection</th></tr>
    </thead>
    <tbody>
    <?php foreach ($alertes as $alerte): ?>
        <tr>
            <td><?= $this->escapeHtml($alerte['id']) ?></td>
            <td><a href="/trace-aes/alerte/view/<?= $this->escapeHtmlAttr($alerte['id']) ?>"><?= $this->escapeHtml($alerte['type_alerte']) ?></a></td>
            <td><?= $this->escapeHtml($alerte['trajet_id']) ?></td>
            <td><span class="badge <?= $badgeParStatut[$alerte['statut']] ?? 'bg-secondary' ?>"><?= $this->escapeHtml($alerte['statut']) ?></span></td>
            <td><?= $this->escapeHtml($alerte['date_detection']) ?></td>
        </tr>
    <?php endforeach; ?>
    <?php if (! count($alertes)): ?>
        <tr><td colspan="5" class="text-muted">Aucune alerte.</td></tr>
    <?php endif; ?>
    </tbody>
</table>
